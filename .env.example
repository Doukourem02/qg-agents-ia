# Les variables du QG. Copie ce fichier en `.env.local` (jamais commité) et mets les mêmes dans les réglages de Vercel.
# Le mode démo (/demo) n'a besoin d'aucune de ces variables. Un agent sans ses variables reste « prévu ».
# Jamais une vraie valeur dans ce fichier ni dans le code.

# ── La base : l'état et le journal des agents (Upstash Redis, ajouté tout seul par le Marketplace de Vercel) ──────────
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (ou, selon ton intégration : UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# ── La preuve d'agent : seuls tes agents entrent dans /api/agents/... ─────────────────────────────────────────────────
# Une longue valeur au hasard (ex. : openssl rand -hex 32), donnée aux agents du Mac (en-tête Authorization: Bearer).
QG_CLE_AGENTS=
# Le laissez-passer de la protection Vercel donné aux routines Claude Code (en-tête x-vercel-protection-bypass).
QG_PASSE_AGENTS=

# ── Kuroro, le CEO : ses réponses dans la page et sur Telegram ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram : les accords (Valider / Refuser), les alertes, la discussion avec Kuroro ────────────────────────────────
TELEGRAM_TOKEN=          # le jeton du bot, donné par @BotFather
TELEGRAM_CHAT_ID=        # ton identifiant Telegram : le seul que le bot écoute et à qui il écrit
TELEGRAM_SECRET=         # le mot que Telegram joint à chaque appel du webhook (setWebhook … secret_token)

# ── GitHub : les agents du Pôle Code ──────────────────────────────────────────────────────────────────────────────────
GITHUB_LECTURE_PERSO=    # jeton en lecture seule de ton compte (Light, Mafe, Léa, Paul, Ye, Zoro)
GITHUB_LECTURE_PRO=      # facultatif : un second compte, en lecture seule
GITHUB_ECRITURE_PERSO=   # Paul : écrit le README après ton « Valider » (droits « Contents : écriture », rien d'autre)

# ── Ye : ton portfolio sur Sanity ─────────────────────────────────────────────────────────────────────────────────────
SANITY_ECRITURE_PORTFOLIO=   # jeton « Editor », utilisé seulement après ton « Valider » ou ton « Ajouter »

# ── L : LinkedIn ──────────────────────────────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Clara : tes mails (IMAP) ──────────────────────────────────────────────────────────────────────────────────────────
GMAIL_ADRESSE=
GMAIL_MOT_DE_PASSE_APPLI=    # un mot de passe d'application, jamais ton mot de passe principal

# ── Facultatif ────────────────────────────────────────────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=           # « En écoute » : la musique du moment s'affiche dans le bureau
SPOTIFY_CLIENT_SECRET=
WHATSAPP_VERIFY_TOKEN=       # WhatsApp, si tu le préfères à Telegram (Meta demande une vérification d'entreprise)
WHATSAPP_APP_SECRET=
WHATSAPP_MON_NUMERO=         # ton numéro, chiffres seulement

# ── Pour les scripts lancés depuis ton Mac (pas besoin dans Vercel) ───────────────────────────────────────────────────
QG_BASE=https://mon-qg.vercel.app    # l'adresse de ta page
QG_BYPASS=                           # le même laissez-passer que QG_PASSE_AGENTS
